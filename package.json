{
  "name": "lifeos",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lifeos/web dev",
    "dev:desktop": "pnpm --filter @lifeos/desktop dev",
    "desktop": "pnpm --filter @lifeos/desktop tauri dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mcp": "tsx services/mcp-server/src/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "9.39.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.4.0",
    "prettier": "3.7.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.23.0",
    "turbo": "2.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.15"
  }
}
